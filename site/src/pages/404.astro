---
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const releases = 'https://github.com/hiyo41/HiyoDyna/releases';
---

<Base
  title="Page not found · HiyoDyna"
  description="That page is not here. Return to HiyoDyna or download the latest release."
  noindex
>
  <main id="main" class="not-found wrap">
    <p class="eyebrow">404</p>
    <h1>That page is not here.</h1>
    <p class="lede">
      The clock is still at the top of the screen. Try the home page or the release downloads.
    </p>
    <div class="button-row">
      <a class="button button--primary" href={base}>Back home</a>
      <a class="button button--ghost" href={releases}>Releases</a>
    </div>
  </main>
</Base>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 100svh;
    max-width: 720px;
    padding-block: 96px;
  }

  .not-found h1 {
    margin-top: 18px;
    font-size: clamp(2.2rem, 6vw, 4.4rem);
  }

  .not-found .lede {
    margin-top: 20px;
  }

  .not-found .button-row {
    margin-top: 30px;
  }
</style>
