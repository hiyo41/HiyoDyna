---
import { ACCENTS, DEFAULT_SETTINGS, type IslandSettings } from '../lib/settings';
import { COMPACT, EXPANDED, superellipsePath } from '../lib/superellipse';

interface Props {
  id: string;
  settings?: IslandSettings;
  alwaysExpanded?: boolean;
  hint?: string;
}

const {
  id,
  settings = DEFAULT_SETTINGS,
  alwaysExpanded = false,
  hint = 'Hover or tap to expand',
} = Astro.props;

const initial = alwaysExpanded ? EXPANDED : COMPACT;
const path = superellipsePath(initial);
const accent = ACCENTS[settings.accent];
---

<div class="island-shell">
  <div class="island-stage">
    <div
      class="island"
      data-island={id}
      data-always-expanded={String(alwaysExpanded)}
      data-expanded={String(alwaysExpanded)}
      data-settings={JSON.stringify(settings)}
      role="button"
      tabindex="0"
      aria-expanded={alwaysExpanded}
      aria-describedby={`island-hint-${id}`}
      style={`--island-accent:${accent};--p:0;--compact-opacity:${alwaysExpanded ? 0 : 1};--expanded-opacity:${alwaysExpanded ? 1 : 0}`}
    >
      <div class="island__content">
        <svg class="island__svg" viewBox="0 0 460 190" aria-hidden="true" focusable="false">
          <defs>
            <linearGradient id={`capsule-${id}`} x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#191B1C"></stop>
              <stop offset="1" stop-color="#111314"></stop>
            </linearGradient>
            <linearGradient id={`rim-${id}`} x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#FFFFFF" stop-opacity="0.18"></stop>
              <stop offset="1" stop-color="#FFFFFF" stop-opacity="0.05"></stop>
            </linearGradient>
          </defs>
          <g transform="translate(20 20)">
            <path class="island__halo" data-halo d={path}></path>
            <path
              class="island__shape"
              data-shape
              d={path}
              fill={`url(#capsule-${id})`}></path>
            <path
              class="island__rim"
              data-rim
              d={path}
              fill="none"
              stroke={`url(#rim-${id})`}
              stroke-width="1"></path>
          </g>
        </svg>

        <div class="island__text island__text--compact" aria-hidden={alwaysExpanded}>
          <span class="island__dot" aria-hidden="true"></span>
          <span class="island__time island__time--compact" data-time-compact>14:03</span>
          <span class="island__meridiem" data-meridiem-compact></span>
          <span class="island__seconds" data-seconds-compact>31</span>
        </div>

        <div class="island__text island__text--expanded" aria-hidden={!alwaysExpanded}>
          <span class="island__date" data-date>Thursday · November 19</span>
          <span class="island__time-line">
            <span class="island__time island__time--expanded" data-time>14:03</span>
            <span class="island__meridiem" data-meridiem></span>
          </span>
          <span class="island__divider" aria-hidden="true"></span>
          <span class="island__seconds island__seconds--expanded" data-seconds>31</span>
        </div>
      </div>
    </div>
  </div>
  <p class="island__hint" id={`island-hint-${id}`}>{hint}</p>
</div>

<script>
  import { initIslands } from '../scripts/island';

  initIslands();
</script>

<style>
  .island-shell {
    width: min(460px, 100%);
    margin-inline: auto;
  }

  .island-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 460 / 190;
  }

  .island {
    position: absolute;
    top: 0;
    left: 50%;
    width: 460px;
    height: 190px;
    transform: translateX(-50%) scale(var(--island-scale, 1));
    transform-origin: top center;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  .island__content {
    position: absolute;
    inset: 0;
    transform: translateY(var(--island-gap, 0px));
  }

  .island__svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .island__shape {
    filter: drop-shadow(0 3px 9px rgb(0 0 0 / 22%));
    transition: filter 220ms ease-out;
  }

  .island[data-shadow='off'] .island__shape {
    filter: none;
  }

  .island__halo {
    fill: var(--island-accent);
    opacity: 0;
    filter: blur(18px);
    transition: opacity 320ms ease-out;
  }

  .island:hover .island__halo,
  .island:focus-visible .island__halo {
    opacity: 0.18;
  }

  .island:hover .island__shape {
    filter: drop-shadow(0 5px 12px rgb(0 0 0 / 30%));
  }

  .island:focus-visible {
    outline: none;
  }

  .island:focus-visible .island__rim {
    stroke: var(--island-accent);
    stroke-width: 1.5;
  }

  .island__text {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    user-select: none;
    font-variant-numeric: tabular-nums;
  }

  .island__text--compact {
    gap: 7px;
    opacity: var(--compact-opacity, 1);
  }

  .island__text--expanded {
    flex-direction: column;
    gap: 5px;
    opacity: var(--expanded-opacity, 0);
  }

  .island__dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--island-accent);
    box-shadow: 0 0 8px color-mix(in srgb, var(--island-accent) 55%, transparent);
  }

  .island__time {
    color: #faf8f7;
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1;
  }

  .island__time--compact {
    font-size: 27px;
  }

  .island__time--expanded {
    font-size: 50px;
  }

  .island__time-line {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
  }

  .island__meridiem {
    font-size: 11px;
    color: #b8aca9;
    line-height: 1;
  }

  .island__time--expanded + .island__meridiem,
  .island__time-line .island__meridiem {
    font-size: 14px;
  }

  .island__meridiem:empty {
    display: none;
  }

  .island__seconds {
    font-size: 12px;
    color: #b8aca9;
    line-height: 1;
    transform: translateY(3px);
  }

  .island__seconds--expanded {
    font-size: 15px;
    transform: none;
  }

  .island__date {
    font-size: 13px;
    line-height: 1;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #a99d9a;
  }

  .island__divider {
    width: 28px;
    height: 2px;
    margin-block: 1px;
    border-radius: 1px;
    background: var(--island-accent);
    opacity: 0.85;
  }

  .island[data-seconds='off'] .island__seconds,
  .island[data-seconds='off'] .island__divider {
    display: none;
  }

  .island__hint {
    margin-top: 14px;
    font-size: 10px;
    line-height: 1;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-align: center;
    color: var(--text-muted);
  }
</style>
