---
const features = [
  {
    title: 'Hover to expand',
    body: 'The capsule opens with a short spring and collapses 160 ms after the pointer leaves. Focus and tap work too.',
  },
  {
    title: 'A real clock',
    body: '24-hour or 12-hour time, optional seconds, and the weekday and date in the expanded panel.',
  },
  {
    title: 'Three accents',
    body: 'Ice, Amber, or Mint. The indicator, divider, and hover glow follow the same color.',
  },
  {
    title: 'The tray is the settings',
    body: 'Motion, bounce, shadow, position, clock, seconds, and the update channel. No settings window to learn.',
  },
  {
    title: 'Native by construction',
    body: 'Rust, Win32, and GDI software rendering. There is no browser engine in the process, and no runtime to install.',
  },
  {
    title: 'Updates that verify',
    body: 'Build and Stable channels, checks at startup and every 30 minutes, and SHA-256 before an update is applied.',
  },
] as const;
---

<ul class="feature-list">
  {
    features.map((feature) => (
      <li class="feature">
        <div class="feature__body">
          <h3>{feature.title}</h3>
          <p>{feature.body}</p>
          {feature.title === 'Three accents' && (
            <span class="feature__accents" aria-hidden="true">
              <span style="--dot:#8FC7FF"></span>
              <span style="--dot:#FFC478"></span>
              <span style="--dot:#96F0C8"></span>
            </span>
          )}
        </div>
      </li>
    ))
  }
</ul>

<style>
  .feature-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--hairline);
  }

  .feature {
    display: block;
    padding-block: 24px;
    border-bottom: 1px solid var(--hairline);
  }

  .feature__body {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 12px clamp(20px, 4vw, 56px);
    align-items: baseline;
  }

  .feature__body p {
    max-width: 34rem;
    font-size: 14px;
    line-height: 1.65;
    color: var(--text-secondary);
  }

  .feature__accents {
    grid-column: 2;
    display: inline-flex;
    gap: 8px;
    padding-top: 6px;
  }

  .feature__accents span {
    inline-size: 10px;
    block-size: 10px;
    border-radius: 50%;
    background: var(--dot);
  }

  @media (max-width: 760px) {
    .feature__body {
      grid-template-columns: 1fr;
      gap: 8px;
    }

    .feature__accents {
      grid-column: 1;
    }
  }
</style>
